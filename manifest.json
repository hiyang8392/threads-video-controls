{
  "manifest_version": 3,
  "name": "Threads Video Controls",
  "description": "打開 Threads 文章內的影片播放器介面，以及自動打開劇透內容",
  "version": "1.3.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.threads.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.threads.com/*"],
      "js": ["execute.js"]
    }
  ]
}